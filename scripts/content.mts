// Content engine CLI.  npx tsx scripts/content.mts <command>
//   matrix                 → writes docs/SOURCE_INTELLIGENCE.md (coverage matrix) from the curriculum
//   export-kb              → prints the retrieval knowledge base as JSON (original paraphrases + pages)
//   seed-kb                → uploads that knowledge base to Supabase (ingest function, mode "kb")
//   ingest-source <pdf>    → uploads the private transcript pages (mode "source"); needs `pdftotext`
//   generate <id|next|all> → asks the generate-level function to draft + validate blueprint levels
// Network commands need SUPABASE_URL, SUPABASE_ANON_KEY and ADMIN_JWT (a signed-in user whose
// profiles.role = 'admin'). They talk only to YOUR Supabase project.
import { execFileSync } from 'node:child_process';
import { writeFileSync } from 'node:fs';
import { authored, blueprint, chapters, path } from '@/content/curriculum';
import { practices } from '@/content/practices';
import { seminarChunks } from '@/lib/coach/kb';
import { TOTAL_PAGES } from '@/lib/validateLevel';

const range = (p: number[]) => (p.length > 1 ? `${p[0]}–${p[p.length - 1]}` : String(p[0] ?? '—'));
const [cmd, arg] = process.argv.slice(2);

async function call(fn: string, body: unknown) {
  const { SUPABASE_URL, SUPABASE_ANON_KEY, ADMIN_JWT } = process.env;
  if (!SUPABASE_URL || !SUPABASE_ANON_KEY || !ADMIN_JWT) throw new Error('Set SUPABASE_URL, SUPABASE_ANON_KEY and ADMIN_JWT');
  const res = await fetch(`${SUPABASE_URL}/functions/v1/${fn}`, { method: 'POST', headers: { 'content-type': 'application/json', apikey: SUPABASE_ANON_KEY, Authorization: `Bearer ${ADMIN_JWT}` }, body: JSON.stringify(body) });
  const out = await res.json().catch(() => ({}));
  if (!res.ok) throw new Error(`${fn} → ${res.status} ${JSON.stringify(out)}`);
  return out;
}

const kbRows = () =>
  seminarChunks.flatMap((c) => (['es', 'en'] as const).map((language) => ({
    language, title: c.title[language], body: c.text[language], pages: c.pages, chapter: c.chapter ?? null,
    kind: c.kind === 'practice' ? 'practice' : 'principle', action: c.action?.[language] ?? null, question: c.question?.[language] ?? null, caveat: c.caveat?.[language] ?? null,
  })));

if (cmd === 'matrix') {
  const covered = new Set(path.flatMap((p) => (p.kind === 'level' ? p.level.pages : p.bp.pages)));
  const missing = Array.from({ length: TOTAL_PAGES }, (_, i) => i + 1).filter((p) => !covered.has(p));
  const lines: string[] = [
    '# Source Intelligence — Seminario Fénix', '',
    '> Generated by `npm run docs:matrix` from `src/content/curriculum.ts`. Do not edit by hand.', '',
    `Source: transcript PDF, ${TOTAL_PAGES} pages. Every level is tied to the pages it paraphrases.`, '',
    `- **Levels mapped:** ${path.length} (${authored.length} fully authored and playable, ${blueprint.length} blueprint rows awaiting generation + validation)`,
    `- **Pages covered:** ${covered.size}/${TOTAL_PAGES} (${Math.round((covered.size / TOTAL_PAGES) * 100)}%)`,
    `- **Pages not mapped to a level:** ${missing.join(', ') || 'none'} — not yet mapped; candidates for future levels`,
    `- **Practices (Mind Studio):** ${practices.length}`, '',
    'Legend — **Status**: ✅ authored · 📝 blueprint. **Type**: T = seminar teaching; T⚠ = seminar teaching that is metaphysical, historical or a health/psychology claim and is shown with a caveat (not established science).', '',
  ];
  for (const ch of chapters) {
    const nodes = path.filter((p) => p.chapter === ch.n);
    lines.push(`## ${ch.n}. ${ch.title.es} / ${ch.title.en}`, '', '| # | Level | Principle (ES) | Pages | Type | Status | Exercise → practice |', '|---|---|---|---|---|---|---|');
    for (const nd of nodes) {
      const lv = nd.kind === 'level' ? nd.level : undefined;
      const title = lv ? lv.title.es : nd.kind === 'blueprint' ? nd.bp.title.es : '';
      const principle = lv ? lv.principle.es : nd.kind === 'blueprint' ? nd.bp.principle.es : '';
      const pages = lv ? lv.pages : nd.kind === 'blueprint' ? nd.bp.pages : [];
      const caveat = lv ? !!lv.caveat : nd.kind === 'blueprint' && nd.bp.caveat;
      const prac = practices.filter((p) => p.origin === 'seminar' && p.pages.some((x) => pages.includes(x))).map((p) => p.title.es).join(', ');
      lines.push(`| ${nd.n} | ${title} | ${principle} | ${range(pages)} | ${caveat ? 'T⚠' : 'T'} | ${lv ? '✅' : '📝'} | ${lv ? `Aplicar: ${lv.apply.es}` : prac || '—'} |`);
    }
    lines.push('');
  }
  lines.push('## Practices derived from the source', '', '| Practice | Origin | Pages | What the user does |', '|---|---|---|---|');
  for (const p of practices) lines.push(`| ${p.title.es} | ${p.origin === 'seminar' ? 'Seminar' : 'App complement (labelled)'} | ${p.pages.join(', ') || '—'} | ${p.what.es} |`);
  writeFileSync('docs/SOURCE_INTELLIGENCE.md', lines.join('\n') + '\n');
  console.log(`docs/SOURCE_INTELLIGENCE.md written: ${path.length} levels, ${covered.size}/${TOTAL_PAGES} pages`);
} else if (cmd === 'export-kb') {
  console.log(JSON.stringify(kbRows(), null, 1));
} else if (cmd === 'seed-kb') {
  console.log(await call('ingest', { mode: 'kb', chunks: kbRows() }));
} else if (cmd === 'ingest-source') {
  if (!arg) throw new Error('usage: ingest-source <path-to-pdf>');
  const pages = execFileSync('pdftotext', ['-layout', arg, '-'], { maxBuffer: 64e6 }).toString().split('\f').map((text, i) => ({ page: i + 1, text: text.replace(/\s+/g, ' ').trim() })).filter((p) => p.text);
  for (let i = 0; i < pages.length; i += 40) console.log(await call('ingest', { mode: 'source', pages: pages.slice(i, i + 40) }));
} else if (cmd === 'generate') {
  const todo = arg === 'all' ? blueprint : arg === 'next' || !arg ? blueprint.slice(0, 1) : blueprint.filter((b) => b.id === arg);
  for (const b of todo) {
    const n = path.find((p) => p.id === b.id)!.n;
    console.log(b.id, await call('generate-level', { id: b.id, chapter: b.chapter, position: n, title: b.title, principle: b.principle, pages: b.pages }));
  }
} else {
  console.log('commands: matrix | export-kb | seed-kb | ingest-source <pdf> | generate <id|next|all>');
}
